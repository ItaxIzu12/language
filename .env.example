# Vorlage für lokale Entwicklung. Beide leeren Pflichtfelder in .env befüllen.
POSTGRES_DB=linguaflow
POSTGRES_USER=linguaflow
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# Lokaler Webzugang und Django-Hostprüfung
WEB_PORT=8080
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_HTTPS=0
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional: Social Login (nur Backend). Apple-PEM mit literalen \n in einfachen Anführungszeichen.
# 1 = bei vollständiger Konfiguration aktiv, 0 = pausiert
GOOGLE_LOGIN_ENABLED=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_LOGIN_ENABLED=1
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
